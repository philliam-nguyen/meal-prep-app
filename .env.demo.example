# Copy to .env.demo and fill in. .env.demo is gitignored and must stay that way.
#
#   docker compose -f compose.demo.yaml --env-file .env.demo up -d
#
# This is the Demo Variant. Every difference between the two Variants is in this file and in
# infrastructure, never in the build (docs/adr/0002-variant-seam-in-infrastructure.md).
#
# Not one value here may match .env. A shared password turns two Compose projects into decoration
# (docs/adr/0008-demo-backend-on-the-homelab.md). Generate each one fresh:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# The same image the Homelab Variant runs. Until ticket 16 publishes to GHCR this is the locally
# built tag; after it, a registry reference pinned to the commit it was built from.
MEAL_PREP_IMAGE=meal-prep-app:local

# Distinct names as well as distinct passwords, so `docker exec` into the wrong container fails
# loudly instead of succeeding against the wrong data.
POSTGRES_DB=meal_prep_demo
POSTGRES_OWNER_ROLE=meal_prep_demo_owner
POSTGRES_OWNER_PASSWORD=
APP_DB_ROLE=meal_prep_demo_app
APP_DB_PASSWORD=

LOG_LEVEL=info

# No API_PORT: this stack publishes no host port. The Tailscale sidecar is the only way in.

# The CloudFront hostname, which is the only origin a browser will ever send. Not the tailnet name:
# nobody reaches this Variant that way, and CORS is about what the browser puts in the header.
CORS_ORIGIN=https://meal-prep.phillip-nguyen.dev

BODY_LIMIT_BYTES=65536
WRITE_RATE_LIMIT=60
WRITE_RATE_WINDOW_MS=60000

# 200 here against the Homelab Variant's 500. The cap and the six-hour restore interval together
# decide the worst state a Reviewer can walk into
# (docs/adr/0010-demo-guardrails-on-shared-hardware.md).
RECIPES_MAX=200

# CloudFront, then nginx on the AWS instance, both appending. `true` would believe a forged leading
# entry and hand one script a fresh bucket per request. See the long note in .env.example, and note
# that this number is only right while both proxies append: a proxy changed to replace is a
# deployment fix, not a retune of this value.
TRUST_PROXY=2

# The Site Notice every visitor reads. The Homelab Variant leaves this blank; that is the whole of
# the difference, and it is a value rather than a mode check.
SITE_NOTICE=This is a public demo. The data is a fixture and it is restored every six hours.

# A reusable Tailscale auth key tagged tag:demo, minted in the admin console. Tagged so the node
# never expires and so the grant in ops/tailnet/policy.hujson applies to it. Note its own expiry
# date, at most 90 days out, somewhere you will look: a rebuild after that date fails to enrol with
# an error that does not say why.
TS_AUTHKEY=
