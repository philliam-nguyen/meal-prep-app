# Copy to backup.env, beside this file, on the homelab host. backup.env is gitignored - it holds
# no passwords itself (dump.sh reads those out of the compose stack's own .env), but the ntfy
# topic below is effectively a bearer credential and does not belong in the repository either.

# Distinguishes this stack's dumps from any other's in the filename, and is never the Demo
# Variant's - ticket 14 does not dump that stack at all.
BACKUP_STACK_NAME=homelab-variant

# The Homelab Variant's Postgres container, by name. compose.yaml sets the project name to
# "meal-prep" and the service to "db", so Compose's default container name is meal-prep-db-1
# unless something has overridden it - check `docker compose ps` if unsure. dump.sh refuses to run
# rather than falling back to whatever Postgres happens to be running if this name is wrong.
HOMELAB_DB_CONTAINER=meal-prep-db-1

# Where compose.yaml's .env lives, so dump.sh can read POSTGRES_OWNER_ROLE, POSTGRES_OWNER_PASSWORD
# and POSTGRES_DB without a second copy of the password to keep in step. Defaults to the .env
# beside compose.yaml in this checkout if left blank.
#COMPOSE_ENV_FILE=/path/to/checkout/.env

# Where dumps are written on this host before the offsite copy.
BACKUP_DIR=/var/backups/meal-prep

# Roughly a month of nightly dumps.
RETENTION_COUNT=30

# Where the offsite copy lands. Two forms:
#   /mnt/nas/meal-prep-backups     a local path - typically a NAS share already mounted on this
#                                   host, copied with `cp`
#   backup@otherhost:meal-prep     user@host:path - copied with `rsync` over `ssh`, reached over
#                                   the tailnet the same way everything else on this host is
#                                   reached, with a key in the operator's ~/.ssh rather than a
#                                   password (BatchMode=yes refuses to prompt for one)
# Required: dump.sh fails loudly rather than silently keeping every dump local only.
OFFSITE_DEST=

# ntfy (https://ntfy.sh) topic that alerts land on - a long, unguessable string, not a word, since
# anyone who knows it can publish to it and read its history. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Subscribe to it in the ntfy app (or at https://ntfy.sh/<topic> in a browser) on the Operator's
# phone before the first real run, or an alert fires into nothing. Required: both scripts refuse to
# start at all if this is blank, the same as OFFSITE_DEST above - "an alert reaches the Operator"
# is a requirement this backup exists to satisfy, not a nicety to skip while getting it running.
NTFY_TOPIC=

# Only needed to point at a self-hosted ntfy instance instead of the public one.
#NTFY_URL=https://ntfy.sh
