[Unit]
Description=Nightly pg_dump of the Homelab Variant's Postgres container
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Adjust to wherever the checkout actually lives on the host - the runbook's example uses
# /opt/meal-prep-app.
WorkingDirectory=/opt/meal-prep-app
# Invoked through bash explicitly rather than relying on the checkout carrying the executable bit -
# a plain `git clone` does, but a zip download or a filesystem that does not track it would
# otherwise turn "the timer is installed" into a silent no-op.
ExecStart=/bin/bash /opt/meal-prep-app/ops/backup/dump.sh
