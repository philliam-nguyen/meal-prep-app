# Copy to .env and fill in. .env is gitignored and must stay that way: it is the only place a
# password or a connection string lives.
#
# Passwords go into connection strings unencoded, so keep them URL-safe - letters, digits, and
# -._~ only. Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

POSTGRES_DB=meal_prep

# Owns the schema and runs migrations. Held only by the migrate container.
POSTGRES_OWNER_ROLE=meal_prep_owner
POSTGRES_OWNER_PASSWORD=

# What the API connects as: no ownership, no DDL rights. Created by the migrate step.
APP_DB_ROLE=meal_prep_app
APP_DB_PASSWORD=

# Host port the stack publishes the API and the frontend on.
API_PORT=8080

LOG_LEVEL=info

# Boundary guardrails. Every one of these is unconditional - the same code runs in both Variants and
# only these numbers differ - so a tighter public instance is a different .env, never a different
# build. Leave one blank to take the default in packages/api/src/config.js.

# The one origin allowed to call this API, scheme and port included, exactly as the browser sends
# it. Set it to however you actually reach the app - the tailnet URL on the Homelab Variant. Get it
# wrong and the app refuses its own saves, not just other sites; config.js explains why there is no
# default to fall back to.
CORS_ORIGIN=http://localhost:8080

# Largest request body accepted, in bytes. Refused against content-length before anything reads it.
BODY_LIMIT_BYTES=65536

# Writes allowed per client address per window. Reads are not counted.
WRITE_RATE_LIMIT=60
WRITE_RATE_WINDOW_MS=60000

# The absolute ceiling on total Recipes, which is what actually bounds the damage a script can do
# (docs/adr/0001-app-level-demo-guardrails.md).
RECIPES_MAX=500

# Whether to read the client address from X-Forwarded-For. On only when something you control
# terminates in front of the API and appends the header, otherwise a caller can claim any address
# and rate limiting keys on a lie. Off for this stack; on for the Demo Variant behind CloudFront.
TRUST_PROXY=false
