# Copy to .env and fill in. .env is gitignored and must stay that way: it is the only place a
# password or a connection string lives.
#
# Passwords go into connection strings unencoded, so keep them URL-safe - letters, digits, and
# -._~ only. Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# The image the API and the migration step both run. Both Variants run one published image, so on
# the homelab this is a registry reference pinned to a tag that names the commit it was built from.
# The value below is the tag the build override produces on a machine that has the source, and
# compose.yaml has no fallback of its own: running the wrong image is not a thing to do quietly.
MEAL_PREP_IMAGE=meal-prep-app:local

POSTGRES_DB=meal_prep

# Owns the schema and runs migrations. Held only by the migrate container.
POSTGRES_OWNER_ROLE=meal_prep_owner
POSTGRES_OWNER_PASSWORD=

# What the API connects as: no ownership, no DDL rights. Created by the migrate step.
APP_DB_ROLE=meal_prep_app
APP_DB_PASSWORD=

# Port on the host's loopback address that the stack publishes the API and the frontend on. Nothing
# off the host reaches it directly; on the homelab `tailscale serve` is what proxies to it.
API_PORT=8080

LOG_LEVEL=info

# Boundary guardrails. Every one of these is unconditional - the same code runs in both Variants and
# only these numbers differ - so a tighter public instance is a different .env, never a different
# build. Leave one blank to take the default in packages/api/src/config.js.

# The one origin allowed to call this API, scheme and port included, exactly as the browser sends
# it. Set it to however you actually reach the app - on the Homelab Variant that is the tailnet URL,
# https://<host>.<tailnet>.ts.net, with no port because TLS terminates on 443. Get it wrong and the
# app refuses its own saves, not just other sites; config.js explains why there is no default to
# fall back to.
CORS_ORIGIN=http://localhost:8080

# Largest request body accepted, in bytes. Refused against content-length before anything reads it.
BODY_LIMIT_BYTES=65536

# Writes allowed per client address per window. Reads are not counted.
WRITE_RATE_LIMIT=60
WRITE_RATE_WINDOW_MS=60000

# The absolute ceiling on total Recipes, which is what actually bounds the damage a script can do
# (docs/adr/0001-app-level-demo-guardrails.md).
RECIPES_MAX=500

# Where in X-Forwarded-For the client address is. Rate limiting keys on whatever this resolves to,
# so a wrong value here does not fail loudly - it buckets people together, or hands one script a
# fresh address per request, while still answering 429 as though it were working. Three forms:
#
#   false  Nothing trusted; the address is whoever opened the socket. Correct when you reach the
#          API directly, on localhost or otherwise. A caller writes X-Forwarded-For themselves, so
#          believing it when no proxy is in the path defeats the limit from the other side.
#   true   The leftmost entry in the header. Correct only in front of a proxy that *replaces*
#          X-Forwarded-For rather than appending to it, because a replacing proxy has already
#          thrown away whatever the caller sent.
#   N      A count of the proxies standing in front of the API, resolved that many hops inward from
#          the socket. Correct in front of *appending* proxies, and the only form that discards a
#          forged entry, since an appending chain leaves one at the left of the list.
#
# The Homelab Variant sets `true`. `tailscale serve` terminates TLS, writes the header with the
# calling tailnet address using Header.Set, and is the only thing that can reach the port. Set
# `false` there and every device shares one bucket keyed on 127.0.0.1.
#
# The Demo Variant sets `2`: CloudFront, then the reverse proxy on the instance, both appending
# (docs/adr/0008-demo-backend-on-the-homelab.md). That count is only right while both append. A
# reverse proxy changed to replace drops the visitor before the API sees them and no value here
# recovers it, so it is a deployment fix rather than a retune of this number.
TRUST_PROXY=false
