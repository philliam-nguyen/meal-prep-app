# Build output and dependencies
node_modules/
dist/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Local configuration: passwords and connection strings live here and nowhere else. The glob covers
# the second stack's file too (.env.demo), because two stacks in one checkout means two of these and
# a pattern matching only the bare name would leave the demo's passwords one `git add .` from being
# published. The negation keeps the committed examples tracked.
.env
.env.*
!.env*.example

# The unattended backup's config: no password of its own, but the ntfy topic in it is a bearer
# credential
ops/backup/backup.env

# The spreadsheet export's Google service account key: a private key in a JSON file. It belongs
# outside this checkout entirely; this is here so that a copy landing in it by accident is not one
# `git add .` away from being published.
*service-account*.json
*credentials*.json

# Draft designs: ephemeral, superseded by the spec they become
docs/drafts/*

# Vendored agent skills, restorable from the committed skills-lock.json
.claude/
.scratch/
